<%- include('partials/header', { titulo: titulo }) %>

<body class="d-flex flex-column min-vh-100">

<%- include('partials/navbar') %>

<main class="flex-grow-1">

    <section class="pagina-hero">

        <div class="container">

            <span class="etiqueta-seccion">Equipo</span>

            <h1>Especialistas</h1>

            <p>
                Cada profesional atiende un área distinta. Si no sabes con quién
                empezar, agenda una primera entrevista y te orientamos.
            </p>

        </div>

    </section>

    <section class="seccion">

        <div class="container">

            <% if (especialistas.length === 0) { %>

                <div class="card shadow-sm">

                    <div class="card-body text-center py-5">

                        <i class="fa-solid fa-user-doctor fs-1 text-muted" aria-hidden="true"></i>
                        <p class="mt-3 mb-0 text-muted">
                            Por el momento no hay especialistas publicados.
                        </p>

                    </div>

                </div>

            <% } else { %>

                <div class="row g-4">

                    <% especialistas.forEach(function (e) { %>

                        <%
                            var limpio = e.nombre.replace(/^(Dra?\.|Lic\.)\s*/i, "").trim();
                            var partes = limpio.split(/\s+/);
                            var iniciales = (partes[0] || "").charAt(0) + (partes[1] || "").charAt(0);
                        %>

                        <div class="col-md-6 col-lg-3">

                            <article class="tarjeta-especialista">

                                <div class="avatar-especialista" aria-hidden="true">
                                    <%= iniciales.toUpperCase() %>
                                </div>

                                <h2><%= e.nombre %></h2>

                                <span class="especialidad"><%= e.especialidad %></span>

                                <p><%= e.descripcion || "Atención personalizada." %></p>

                            </article>

                        </div>

                    <% }); %>

                </div>

            <% } %>

            <div class="text-center mt-5">

                <a href="/citas" class="btn btn-primary btn-lg fw-bold">
                    <i class="fa-solid fa-calendar-plus me-2" aria-hidden="true"></i>
                    Agendar una cita
                </a>

            </div>

        </div>

    </section>

</main>

<%- include('partials/alerts') %>

<%- include('partials/footer') %>

</body>
</html>
