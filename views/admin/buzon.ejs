<%- include('../partials/header', { titulo: 'Buzón de sugerencias' }) %>

<body class="d-flex flex-column min-vh-100">

<%- include('../partials/navbar') %>

<main class="flex-grow-1">

    <div class="container mt-5">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">

            <div>
                <span class="etiqueta-seccion">Administración</span>
                <h1 class="seccion-titulo mt-2 mb-1">Buzón de sugerencias</h1>
                <p class="text-muted mb-0 small">
                    Lo que escriben los pacientes. Solo el administrador puede leerlo.
                </p>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="badge badge-estado <%= sinLeer > 0 ? 'badge-pendiente' : 'badge-cancelada' %>">
                    <%= sinLeer %> sin leer
                </span>

                <a href="/dashboard" class="btn btn-outline-secondary btn-sm">
                    <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>
                    Volver al panel
                </a>
            </div>

        </div>

        <% if (mensajes.length === 0) { %>

            <div class="card shadow-sm">

                <div class="card-body text-center py-5">

                    <i class="fa-regular fa-envelope-open fs-1 text-muted" aria-hidden="true"></i>
                    <p class="mt-3 mb-1 fw-bold">El buzón está vacío.</p>
                    <p class="text-muted small mb-0">
                        Aquí aparecerán los mensajes que envíen los pacientes desde su panel.
                    </p>

                </div>

            </div>

        <% } else { %>

            <div class="d-flex flex-column gap-3">

                <% mensajes.forEach(function (m) { %>

                    <article class="card shadow-sm <%= m.leido ? '' : 'border-primary' %>">

                        <div class="card-body">

                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">

                                <div>
                                    <h2 class="h6 fw-bold mb-1">
                                        <%= m.asunto %>
                                        <% if (!m.leido) { %>
                                            <span class="badge badge-estado badge-pendiente ms-1">nuevo</span>
                                        <% } %>
                                    </h2>
                                    <p class="text-muted small mb-0">
                                        <i class="fa-solid fa-user me-1" aria-hidden="true"></i>
                                        <%= m.nombre %>
                                        <span class="mx-2">·</span>
                                        <i class="fa-regular fa-clock me-1" aria-hidden="true"></i>
                                        <%= m.fecha %>
                                    </p>
                                </div>

                                <div class="d-flex gap-2">

                                    <form action="/admin/buzon/<%= m.id %>/leido" method="POST">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="btn btn-sm btn-outline-primary">
                                            <%= m.leido ? 'Marcar como nuevo' : 'Marcar como leído' %>
                                        </button>
                                    </form>

                                    <form action="/admin/buzon/<%= m.id %>/eliminar" method="POST">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Eliminar
                                        </button>
                                    </form>

                                </div>

                            </div>

                            <p class="mb-0" style="white-space: pre-wrap;"><%= m.mensaje %></p>

                        </div>

                    </article>

                <% }); %>

            </div>

        <% } %>

    </div>

</main>

<%- include('../partials/alerts') %>

<%- include('../partials/footer') %>

</body>
</html>
