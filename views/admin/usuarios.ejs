<%- include('../partials/header', { titulo: 'Usuarios' }) %>

<body class="d-flex flex-column min-vh-100">

<%- include('../partials/navbar') %>

<main class="flex-grow-1">

    <div class="container mt-5">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">

            <div>
                <span class="etiqueta-seccion">Administración</span>
                <h1 class="seccion-titulo mt-2 mb-1">Usuarios</h1>
                <p class="text-muted mb-0 small">
                    Crea cuentas, asigna roles y desactiva accesos sin borrar el historial.
                </p>
            </div>

            <a href="/dashboard" class="btn btn-outline-secondary btn-sm">
                <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>
                Volver al panel
            </a>

        </div>

        <div class="row g-4">

            <!-- ---------- Nuevo usuario ---------- -->
            <div class="col-lg-4">

                <div class="card shadow-sm">

                    <div class="card-body">

                        <h2 class="h5 fw-bold mb-3">Nuevo usuario</h2>

                        <form action="/admin/usuarios" method="POST">

                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                            <div class="mb-3">
                                <label for="nombre" class="form-label">Nombre completo</label>
                                <input type="text" name="nombre" id="nombre" class="form-control" maxlength="120" required>
                            </div>

                            <div class="mb-3">
                                <label for="correo" class="form-label">Correo</label>
                                <input type="email" name="correo" id="correo" class="form-control" required>
                            </div>

                            <div class="mb-3">
                                <label for="password" class="form-label">Contraseña temporal</label>
                                <input type="text" name="password" id="password" class="form-control" minlength="8" required>
                                <div class="form-text">Mínimo 8 caracteres. Compártela y pide que la cambie.</div>
                            </div>

                            <div class="mb-3">
                                <label for="rol" class="form-label">Rol</label>
                                <select name="rol" id="rol" class="form-select" required>
                                    <% roles.forEach(function (r) { %>
                                        <option value="<%= r %>" <%= r === 'paciente' ? 'selected' : '' %>><%= r %></option>
                                    <% }); %>
                                </select>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fa-solid fa-user-plus me-2" aria-hidden="true"></i>
                                Crear usuario
                            </button>

                        </form>

                        <hr>

                        <p class="text-muted small mb-0">
                            <i class="fa-solid fa-shield-halved me-1" aria-hidden="true"></i>
                            Siempre debe quedar al menos un administrador activo.
                            No puedes cambiar tu propio rol ni desactivar tu cuenta.
                        </p>

                    </div>

                </div>

            </div>

            <!-- ---------- Lista ---------- -->
            <div class="col-lg-8">

                <div class="card shadow-sm">

                    <div class="card-body">

                        <form action="/admin/usuarios" method="GET" class="row g-2 mb-3">

                            <div class="col-sm-5">
                                <input
                                    type="search"
                                    name="q"
                                    class="form-control"
                                    placeholder="Buscar por nombre o correo"
                                    value="<%= busqueda %>">
                            </div>

                            <div class="col-sm-4">
                                <select name="rol" class="form-select">
                                    <option value="">Todos los roles</option>
                                    <% roles.forEach(function (r) { %>
                                        <option value="<%= r %>" <%= filtroRol === r ? 'selected' : '' %>><%= r %></option>
                                    <% }); %>
                                </select>
                            </div>

                            <div class="col-sm-3">
                                <button class="btn btn-outline-primary w-100" type="submit">Filtrar</button>
                            </div>

                        </form>

                        <div class="table-responsive">

                            <table class="table align-middle tabla-citas mb-0">

                                <thead>
                                    <tr>
                                        <th scope="col">Usuario</th>
                                        <th scope="col">Rol</th>
                                        <th scope="col">Alta</th>
                                        <th scope="col">Estado</th>
                                        <th scope="col" class="text-end">Acciones</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    <% usuarios.forEach(function (u) { %>

                                        <tr class="<%= u.activo ? '' : 'opacity-75' %>">

                                            <td>
                                                <span class="fw-bold d-block"><%= u.nombre %></span>
                                                <span class="text-muted small"><%= u.correo %></span>
                                                <span class="text-muted small d-block"><%= u.citas %> cita(s)</span>
                                            </td>

                                            <td>
                                                <% if (u.id === usuarioActual) { %>
                                                    <span class="badge badge-estado badge-confirmada"><%= u.rol %></span>
                                                <% } else { %>
                                                    <form action="/admin/usuarios/<%= u.id %>/rol" method="POST" class="d-flex gap-1">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <select name="rol" class="form-select form-select-sm" style="min-width: 120px;">
                                                            <% roles.forEach(function (r) { %>
                                                                <option value="<%= r %>" <%= u.rol === r ? 'selected' : '' %>><%= r %></option>
                                                            <% }); %>
                                                        </select>
                                                        <button type="submit" class="btn btn-sm btn-outline-primary" title="Guardar rol">
                                                            <i class="fa-solid fa-check" aria-hidden="true"></i>
                                                        </button>
                                                    </form>
                                                <% } %>
                                            </td>

                                            <td class="small text-nowrap"><%= u.alta %></td>

                                            <td>
                                                <span class="badge badge-estado <%= u.activo ? 'badge-atendida' : 'badge-cancelada' %>">
                                                    <%= u.activo ? 'activo' : 'inactivo' %>
                                                </span>
                                            </td>

                                            <td class="text-end text-nowrap">

                                                <% if (u.id === usuarioActual) { %>

                                                    <span class="text-muted small">Tu cuenta</span>

                                                <% } else { %>

                                                    <form action="/admin/usuarios/<%= u.id %>/estado" method="POST">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <button
                                                            type="submit"
                                                            class="btn btn-sm <%= u.activo ? 'btn-outline-danger' : 'btn-outline-success' %>">
                                                            <%= u.activo ? 'Desactivar' : 'Activar' %>
                                                        </button>
                                                    </form>

                                                <% } %>

                                            </td>

                                        </tr>

                                    <% }); %>

                                    <% if (usuarios.length === 0) { %>
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">
                                                No hay usuarios que coincidan con el filtro.
                                            </td>
                                        </tr>
                                    <% } %>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</main>

<%- include('../partials/alerts') %>

<%- include('../partials/footer') %>

</body>
</html>
