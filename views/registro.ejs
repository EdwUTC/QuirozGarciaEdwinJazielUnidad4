<%- include('partials/header', { titulo: 'Registro', extraCss: '/css/auth-transicion.css' }) %>

<body class="d-flex flex-column min-vh-100">

<%- include('partials/navbar') %>

<main class="flex-grow-1">

    <div class="container py-5">

        <div class="auth-wrap">

            <aside class="auth-panel">

                <span class="etiqueta-seccion">Un Rayito de Sol</span>

                <h1>Crea tu cuenta</h1>

                <p>
                    Con tu cuenta puedes agendar citas, llevar un diario de
                    emociones y escribirle a la licenciada.
                </p>

                <ul class="auth-lista">

                    <li>
                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                        Tus datos se tratan de forma confidencial
                    </li>

                    <li>
                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                        Eliges especialista, fecha y hora
                    </li>

                    <li>
                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                        Puedes cancelar cuando lo necesites
                    </li>

                </ul>

            </aside>

            <section class="auth-card">

                <h2>Registro de paciente</h2>

                <p class="auth-sub">
                    Solo necesitamos unos datos para crear tu expediente.
                </p>

                <form action="/registro" method="POST">

                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="mb-3">

                        <label for="nombre" class="form-label">Nombre completo</label>

                        <input
                            type="text"
                            name="nombre"
                            id="nombre"
                            class="form-control"
                            autocomplete="name"
                            maxlength="120"
                            required>

                    </div>

                    <div class="mb-3">

                        <label for="correo" class="form-label">Correo electrónico</label>

                        <input
                            type="email"
                            name="correo"
                            id="correo"
                            class="form-control"
                            autocomplete="email"
                            required>

                    </div>

                    <div class="mb-3">

                        <label for="password" class="form-label">Contraseña</label>

                        <input
                            type="password"
                            name="password"
                            id="password"
                            class="form-control"
                            autocomplete="new-password"
                            minlength="8"
                            required>

                        <div class="form-text">Al menos 8 caracteres.</div>

                    </div>

                    <% if (siteKey) { %>

                        <div class="mb-3">
                            <div class="g-recaptcha" data-sitekey="<%= siteKey %>"></div>
                        </div>

                    <% } else { %>

                        <div class="alert alert-warning small">
                            Falta configurar <code>RECAPTCHA_SITE_KEY</code> en el archivo
                            <code>.env</code>.
                        </div>

                    <% } %>

                    <button type="submit" class="btn btn-primary w-100">
                        Crear cuenta
                    </button>

                </form>

                <p class="auth-pie mb-0 mt-4">
                    ¿Ya tienes cuenta?
                    <a href="/login" class="fw-bold">Inicia sesión</a>
                </p>

            </section>

        </div>

    </div>

</main>

<%- include('partials/alerts') %>

<%- include('partials/footer') %>

<% if (siteKey) { %>
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
<% } %>

</body>
</html>
