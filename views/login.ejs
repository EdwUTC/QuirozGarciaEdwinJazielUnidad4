<%- include('partials/header', { titulo: 'Login', extraCss: '/css/auth-transicion.css' }) %>

<body class="d-flex flex-column min-vh-100">

<%- include('partials/navbar') %>

<main class="flex-grow-1">

    <div class="container py-5">

        <div class="auth-wrap">

            <aside class="auth-panel">

                <span class="etiqueta-seccion">Un Rayito de Sol</span>

                <h1>Qué bueno verte de nuevo</h1>

                <p>
                    Entra para revisar tus citas, tu diario de emociones y tus
                    mensajes con la licenciada.
                </p>

                <ul class="auth-lista">

                    <li>
                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                        Agenda y cancela tus citas
                    </li>

                    <li>
                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                        Lleva tu diario de emociones
                    </li>

                    <li>
                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                        Conversa en privado con la licenciada
                    </li>

                </ul>

            </aside>

            <section class="auth-card">

                <h2>Iniciar sesión</h2>

                <p class="auth-sub">
                    Usa el correo con el que te registraste.
                </p>

                <form action="/login" method="POST">

                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="mb-3">

                        <label for="correo" class="form-label">Correo electrónico</label>

                        <input
                            type="email"
                            name="correo"
                            id="correo"
                            class="form-control"
                            autocomplete="email"
                            required>

                    </div>

                    <div class="mb-3">

                        <label for="password" class="form-label">Contraseña</label>

                        <input
                            type="password"
                            name="password"
                            id="password"
                            class="form-control"
                            autocomplete="current-password"
                            required>

                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        Entrar
                    </button>

                </form>

                <p class="auth-pie">
                    <a href="/recuperar">¿Olvidaste tu contraseña?</a>
                </p>

                <hr>

                <p class="auth-pie mb-0">
                    ¿Aún no tienes cuenta?
                    <a href="/registro" class="fw-bold">Regístrate</a>
                </p>

            </section>

        </div>

    </div>

</main>

<%- include('partials/alerts') %>

<%- include('partials/footer') %>

</body>
</html>
